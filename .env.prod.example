# Production environment template. PLACEHOLDERS ONLY — never real secrets.
# Copy to `.env.prod` (git-ignored) and fill every CHANGE-ME value from the
# vault. `.env.prod` must never be committed. Forward-only: rotate by issuing
# new values, never by editing history.
#
#   cp .env.prod.example .env.prod

# --- image / registry ---
REGISTRY=CHANGE-ME-registry-example
IMAGE_TAG=CHANGE-ME-image-tag
HOST_PORT=8080

# --- mysql (compose service `mysql`, mysql 8.4) ---
DB_NAME=legalrust
DB_USER=CHANGE-ME-db-user
DB_PASSWORD=CHANGE-ME-db-password
DB_ROOT_PASSWORD=CHANGE-ME-db-root-password

# --- redis (compose service `redis`) ---
REDIS_PASSWORD=CHANGE-ME-redis-password

# --- app (consumed by server + worker; see crates/infrastructure Config) ---
PORT=8080
DATABASE_URL=CHANGE-ME-mysql-url
REDIS_URL=CHANGE-ME-redis-url
S3_ENDPOINT=CHANGE-ME-s3-endpoint
S3_BUCKET=CHANGE-ME-s3-bucket
JWT_SECRET=CHANGE-ME-jwt-secret
INTEGRATION_SECRET=CHANGE-ME-integration-secret

# --- tripay payment gateway (merchant panel https://tripay.co.id/member) ---
TRIPAY_MODE=sandbox
#TRIPAY_BASE_URL=CHANGE-ME-tripay-base-url-override
TRIPAY_API_KEY=CHANGE-ME-tripay-api-key
TRIPAY_PRIVATE_KEY=CHANGE-ME-tripay-private-key
TRIPAY_MERCHANT_CODE=CHANGE-ME-tripay-merchant-code
TRIPAY_CALLBACK_URL=CHANGE-ME-public-callback-url
TRIPAY_RETURN_URL=CHANGE-ME-public-return-url

# --- AI chat (Ollama lokal default di kode; isi untuk provider HTTPS) ---
#AI_BASE_URL=CHANGE-ME-ai-base-url
#AI_MODEL=CHANGE-ME-ai-model
#AI_API_KEY=CHANGE-ME-ai-api-key
#AI_TIMEOUT_SECS=120

# --- CORS browser (kosong = same-origin only) ---
#CORS_ORIGINS=CHANGE-ME-extra-origins

# --- backups (see scripts/backup.sh; env-only, never commit real values) ---
DB_HOST=CHANGE-ME-db-host
S3_BUCKET_BACKUP=CHANGE-ME-backup-bucket
GPG_RECIPIENT=CHANGE-ME-gpg-recipient
BACKUP_DIR=/var/backups/legalrust
