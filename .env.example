PORT=8080
DATABASE_URL=mysql://root:legalrust@127.0.0.1:3306/legalrust
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=legalrust
JWT_SECRET=change-me-in-production
RUST_LOG=legalrust=debug,tower_http=info

# --- tripay payment gateway (https://tripay.co.id/member). PLACEHOLDERS ONLY.
# Merchant code + API key + private key dari panel merchant Tripay.
# Tanpa ini, POST /api/v1/invoices/{id}/pay-gateway = 501 dan callback ditolak.
# TRIPAY_MODE=sandbox|production (default sandbox). TRIPAY_BASE_URL opsional
# (override untuk test/proxy; contoh sandbox di bawah).
#TRIPAY_MODE=sandbox
#TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
#TRIPAY_API_KEY=CHANGE-ME-tripay-api-key
#TRIPAY_PRIVATE_KEY=CHANGE-ME-tripay-private-key
#TRIPAY_MERCHANT_CODE=CHANGE-ME-tripay-merchant-code
#TRIPAY_CALLBACK_URL=https://app-anda.id/api/v1/webhooks/incoming/tripay
#TRIPAY_RETURN_URL=https://app-anda.id/app

# --- AI chat (OpenAI-compatible; default = Ollama lokal tanpa key) ---
#AI_BASE_URL=http://127.0.0.1:11434/v1
#AI_MODEL=qwen2.5:1.5b
#AI_API_KEY=
#AI_TIMEOUT_SECS=120

# --- CORS browser (kosong = same-origin only; koma-pisah untuk klien eksternal) ---
#CORS_ORIGINS=
